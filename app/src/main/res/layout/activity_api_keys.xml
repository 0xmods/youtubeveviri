<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Anahtar Ayarları"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kendi anahtarlarınızı girerseniz çeviriler sizin kotanız üzerinden yapılır. Boş bırakırsanız gömülü anahtarlar kullanılır."
            android:textColor="#AAAAAA"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Google Gemini Anahtarı"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="https://aistudio.google.com/apikey adresinden ücretsiz alın (AIza... ile başlar)"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etGeminiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#2A2A2A"
                    android:hint="AIza..."
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. NVIDIA Riva Anahtarı"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="https://build.nvidia.com adresinden ücretsiz alın (nvapi- ile başlar)"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etNvidiaKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#2A2A2A"
                    android:hint="nvapi-..."
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveKeys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#388E3C"
                android:focusable="true"
                android:text="Kaydet"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnClearKeys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:backgroundTint="#D32F2F"
                android:focusable="true"
                android:text="Temizle (Gömülüye Dön)"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- USB / Depolama'dan anahtar dosyası içe aktar: TV'de yazmadan kurulum -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#263238"
            app:cardCornerRadius="12dp"
            app:strokeColor="#455A64"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💾 TV'de Yazmadan Kurulum (Önerilen)"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="PC'de veya telefonda Not Defteri ile 'api_keys.txt' adında bir dosya oluşturun, içine anahtarlarınızı yazın (GEMINI_API_KEY=... / NVIDIA_API_KEY=...), USB belleğe kopyalayıp TV'ye takın. Aşağıdaki butonla dosyayı seçin — anahtarlar otomatik doldurulur."
                    android:textColor="#B0BEC5"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnImportFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1976D2"
                    android:focusable="true"
                    android:text="Dosyadan Yükle (USB/Depolama)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvKeysStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
